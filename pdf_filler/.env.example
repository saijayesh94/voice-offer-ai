# ---------------------------------------------------------------
# MaxHome PDF filler (FastAPI) — copy to pdf_filler/.env
# ---------------------------------------------------------------

# RealtyFeed MLS API (property lookup by MLS listing id)
MLS_CLIENT_ID=your-realtyfeed-client-id
MLS_CLIENT_SECRET=your-realtyfeed-client-secret
MLS_API_KEY=your-realtyfeed-api-key

# DocuSign eSignature (JWT grant)
DS_CLIENT_ID=your-docusign-integration-key
DS_IMPERSONATED_USER_ID=your-docusign-user-id
# account-d.docusign.com = demo/sandbox, account.docusign.com = production
DS_AUTH_SERVER=account-d.docusign.com
# RSA private key for the DocuSign app, relative to pdf_filler/src (git-ignored)
DS_PRIVATE_KEY_FILE=./third_party/docu_sign/app/private.key
