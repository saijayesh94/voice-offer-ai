# ---------------------------------------------------------------
# MaxHome chat server (Node/Express) — copy to server/.env
# ---------------------------------------------------------------

# Port the Express server listens on
PORT=3000

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used for the conversation
GEMINI_MODEL=gemini-2.0-flash-exp

# Path to the Google Cloud service-account JSON used for Text-to-Speech.
# Optional: defaults to server/src/lustrous-bounty-443706-b7-fc7c62d3c244.json.
# Leave commented out when running in Docker (the default path works inside the container).
# GOOGLE_APPLICATION_CREDENTIALS=./src/your-service-account.json

# PDF filler endpoint called when the offer conversation is complete
PDF_FILLER_URL=https://<region>-<project>.cloudfunctions.net/<function-name>

# Who is CC'd on the DocuSign envelope sent to the buyer
OFFER_CC_EMAIL=agent@example.com
OFFER_CC_NAME=Agent Name
