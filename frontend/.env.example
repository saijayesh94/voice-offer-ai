# ---------------------------------------------------------------
# MaxHome frontend (React / CRA) — copy to frontend/.env
# Only variables prefixed with REACT_APP_ are exposed to the app.
# They are baked in at build time: re-run `npm run build` after changing them.
# Never put secrets here — everything in this file ends up in the browser bundle.
# ---------------------------------------------------------------

# Chat endpoint of the Node server
REACT_APP_CHAT_API_URL=http://localhost:3000/chat

# fill_pdf endpoint of the PDF filler service
REACT_APP_PDF_API_URL=http://localhost:82/fill_pdf
